# ==============================================================================
# Student Feedback Analyzer — Environment Configuration Template
# ==============================================================================
# Copy this file to .env in backend/ or root as needed.
# NEVER commit real credentials or secrets to version control.

# Backend Server Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback_analyzer

# Security & Authentication
# Generate a strong 256-bit secret for production JWT signing
JWT_SECRET=super_secret_development_key_change_in_production_32chars

# Cross-Service Network URLs
NLP_SERVICE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# Frontend Environment Variables (Prefix with VITE_ for Vite bundling)
VITE_API_BASE_URL=http://localhost:5000/api/v1
