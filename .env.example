# =============================================================================
# Student Feedback Analyzer — Environment Configuration Template
# =============================================================================
# Quick Start: Copy this file to .env before starting local development:
#   cp .env.example .env
#
# NEVER commit your actual .env file or real production credentials to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server & Environment Mode
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Number of reverse proxy hops to trust (0 for local dev; 1 on Render/PaaS)
TRUST_PROXY_HOPS=0

# -----------------------------------------------------------------------------
# 2. Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Local development PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feedback_analyzer

# Production Neon PostgreSQL example (Free tier, perpetual, with TLS):
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-forest-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional TLS certificate verification mode (defaults to unverified TLS for remote cloud databases)
# DATABASE_SSL_MODE=verify-full

# -----------------------------------------------------------------------------
# 3. Security & Authentication
# -----------------------------------------------------------------------------
# Secret key for signing and verifying JWT tokens (Min 32 characters in production)
JWT_SECRET=super_secret_production_key_change_in_real_deployment_32chars

# -----------------------------------------------------------------------------
# 4. Cross-Service & Frontend URLs
# -----------------------------------------------------------------------------
# Local development URLs:
NLP_SERVICE_URL=http://127.0.0.1:8000
NLP_TIMEOUT_MS=2000

# Production Cloud URLs:
# NLP_SERVICE_URL=https://<your-nlp-service>.onrender.com
# NLP_TIMEOUT_MS=10000

# Shared secret between API Gateway and NLP Service (Never expose to frontend!)
# Set to an identical random string on both the Backend and NLP services.
NLP_SERVICE_TOKEN=

# URL where the frontend is served (for Backend CORS validation):
FRONTEND_URL=http://localhost:5173
# Production: FRONTEND_URL=https://<your-frontend-service>.onrender.com

# Frontend API base URL (injected at Vite compile/build time):
VITE_API_BASE_URL=http://localhost:5000/api/v1
# Production: VITE_API_BASE_URL=https://<your-backend-service>.onrender.com/api/v1

# -----------------------------------------------------------------------------
# 5. Demo Account Credentials (used during local database seeding)
# -----------------------------------------------------------------------------
DEMO_FACULTY_PASSWORD=SecurePassword123!
DEMO_STUDENT_PASSWORD=SecureStudent123!
