{
  "name": "feedback-analyzer-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Express API Gateway and Aggregation Engine for Student Feedback Analyzer",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-concurrency=1 tests/**/*.test.js",
    "db:migrate": "node src/db/migrate.js",
    "db:provision": "node src/db/provision.js",
    "db:seed": "node src/db/seeds/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  }
}
